# Kopjo këtë skedar si .env.local (nuk futet në Git) dhe plotëso vlerat.
#
# Hash-i i kodit privat të hyrjes. Gjeneroje me:
#   npm run hash-code -- "kodi-yt-i-forte"
# Mos përdor ditëlindjen apo diçka të lehtë për t'u gjetur.
ACCESS_CODE_HASH=

# Sekret i rastësishëm (≥ 32 bajte) për nënshkrimin e sesionit.
# `npm run hash-code` printon edhe një vlerë të gatshme.
SESSION_SECRET=

# Kohëzgjatja e sesionit në orë (opsionale, parazgjedhur 12).
SESSION_TTL_HOURS=12
