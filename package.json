{
  "name": "nadia",
  "version": "0.5.0",
  "private": true,
  "description": "NADIA — dhuratë private ditëlindjeje: yll simbolik, website interaktiv dhe paketë printimi.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "hash-code": "node scripts/hash-code.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run audit:private",
    "gallery:placeholders": "node scripts/make-placeholders.mjs && node scripts/prepare-gallery.mjs private/placeholders",
    "gallery:prepare": "node scripts/prepare-gallery.mjs",
    "placeholders": "node scripts/make-placeholders.mjs && node scripts/prepare-gallery.mjs private/placeholders",
    "test:access": "node scripts/test-access.mjs",
    "audit:private": "node scripts/audit-private.mjs",
    "private:upload": "node --env-file=.env.production.local scripts/upload-private.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "aws4fetch": "1.0.20",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  }
}
